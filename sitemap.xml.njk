---
---
<?xml version="1.0" encoding="UTF-8" ?>
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">

  <url>
    <loc>{{ site.url }}/</loc>
    <lastmod>{{
      [
        'src/main.html.njk',
        'src/includes/app-shell.njk',
        'src/includes/head-macros.njk',
        'src/includes/app-json-ld.njk',
        'data/i18n.js',
        'data/site.json',
        'package.json'
      ] | sitemapLastmod
    }}</lastmod>
    {% for alternate in i18n.locales %}
    <xhtml:link rel="alternate" hreflang="{{ i18n.pages[alternate].htmlLang }}" href="{{ site.url }}/{{ alternate }}/" />
    {% endfor %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}/" />
    <priority>1.0</priority>
  </url>

  {% for locale in i18n.locales %}
  {% set loc = site.url + '/' + locale + '/' %}
  <url>
    <loc>{{ loc }}</loc>
    <lastmod>{{
      [
        'src/' ~ locale ~ '/index.html.njk',
        'src/includes/app-shell.njk',
        'src/includes/head-macros.njk',
        'src/includes/app-json-ld.njk',
        'data/i18n-' ~ locale ~ '.js',
        'data/i18n.js',
        'data/site.json',
        'package.json'
      ] | sitemapLastmod
    }}</lastmod>
    {% for alternate in i18n.locales %}
    <xhtml:link rel="alternate" hreflang="{{ i18n.pages[alternate].htmlLang }}" href="{{ site.url }}/{{ alternate }}/" />
    {% endfor %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}/" />
    <priority>0.9</priority>
  </url>
  {% endfor %}

</urlset>
